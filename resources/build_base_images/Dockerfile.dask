# dask-gateway-server image for local mode.
# We copy paste https://github.com/dask/dask-gateway/blob/main/dask-gateway-server/Dockerfile
# and make modifications for the local mode.

# Build the base dask-gateway image for local and cluster modes.

ARG PYTHON_VERSION_BASE=xxx
FROM python:${PYTHON_VERSION_BASE}-slim-bookworm

ARG DASK_TAG=2024.5.2
ARG DASK_GATEWAY_TAG=2024.1.0

COPY ./layer-cleanup.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/layer-cleanup.sh

COPY ./dask-gateway /opt/dask-gateway
COPY ./dask-gateway-server /opt/dask-gateway-server

# Do the same as in:
# https://github.com/dask/dask-gateway/blob/main/dask-gateway/Dockerfile
# https://github.com/dask/dask-gateway/blob/main/dask-gateway-server/Dockerfile

# Install tini and upgrade linux packages are updated to patch known
# vulnerabilities.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y \
        tini \
 && layer-cleanup.sh

# Install the requirements.txt files and our custom dependencies.
# Add bokeh and jupyter-server-proxy for the dask dashboard.
RUN \
    pip install --upgrade pip && \
    pip install -r /opt/dask-gateway/Dockerfile.requirements.txt && \
    pip install -r /opt/dask-gateway-server/Dockerfile.requirements.txt && \
    pip install \
        dask==${DASK_TAG} \
        distributed==${DASK_TAG} \
        dask-gateway==${DASK_GATEWAY_TAG} \
        dask-gateway-server[local,kubernetes]==${DASK_GATEWAY_TAG} \
        bokeh">=3.1.0" \
        jupyter-server-proxy \
    && layer-cleanup.sh

# Remove custom scripts
RUN rm -rf /usr/local/bin/layer-cleanup.sh /opt/dask-gateway /opt/dask-gateway-server

# Create a non-root user to run as
RUN useradd --create-home --user-group --uid 1000 dask
USER dask:dask
ENV PATH=/home/dask/.local/bin:$PATH
WORKDIR /home/dask/

ENTRYPOINT ["tini", "-g", "--"]

# Set labels based on the Open Containers Initiative (OCI):
# https://github.com/opencontainers/image-spec/blob/main/annotations.md#pre-defined-annotation-keys
#
LABEL org.opencontainers.image.source="https://github.com/RS-PYTHON/rs-demo"
LABEL org.opencontainers.image.ref.name="ghcr.io/rs-python/dask/dask-gateway"
LABEL dockerfile.url="https://github.com/RS-PYTHON/rs-server/blob/develop/resources/build_base_images/Dockerfile.dask"
