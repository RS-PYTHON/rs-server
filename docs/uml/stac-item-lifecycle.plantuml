@startuml stac-item-lifecycle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ParticipantBackgroundColor #E0F2F1
  ParticipantBorderColor #00796B
  LifeLineBorderColor #00796B
}

actor John
participant "Prefect flow\n(rs-client-libraries)" as flow
participant "rs-dpr-service\n+ DPR processor" as dpr
database "Object storage\n(S3)" as s3
participant "rs-server-catalog" as catalog
participant "Data lifecycle\n(periodic task\nof the catalog)" as lifecycle

John -> flow : run a processing flow
flow -> dpr : run the processor (payload file)
dpr -> s3 : write the products\ns3://<bucket>/<owner>/<collection>/...
dpr --> flow : job completed
flow -> flow : create the STAC items from the products metadata\n+datetime, start_datetime, end_datetime = sensing times\n+eopf:origin_datetime = max(origin dates of the inputs)\n+processing:* and product:* metadata, derived_from links
flow -> catalog : POST /catalog/collections/John:s3-l1/items
catalog -> s3 : check that the assets exist
catalog -> catalog : +owner=John, +file:checksum\n+created, +updated, +published = now()\n+expires = now() + expiration delay (bucket configuration)
catalog --> flow : STAC item
flow --> John : published STAC items

== expiration delay later ==
lifecycle -> catalog : search the expired items (expires < now, no unpublished date)
lifecycle -> s3 : delete the assets
lifecycle -> catalog : remove the assets\n+unpublished = now(), +updated = now()
@enduml
