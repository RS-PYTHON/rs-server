@startuml stac-model
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #E0F2F1
  BorderColor #00796B
  ArrowColor #00796B
}
hide circle
hide methods

class "Catalog\n(landing page)" as Catalog {
  type = "Catalog"
  stac_version
  id
  title, description
  links
}
class Collection {
  type = "Collection"
  stac_version, stac_extensions
  id
  title, description, keywords
  license
  providers
  extent: spatial, temporal
  summaries
  owner
  links
  assets
}
class "Item\n(GeoJSON Feature)" as Item {
  type = "Feature"
  stac_version, stac_extensions
  id
  geometry, bbox
  properties
  collection
  links
  assets
}
class Properties {
  datetime, start_datetime, end_datetime
  created, updated, published, expires, unpublished
  owner, platform, constellation, instruments
  product:*, processing:*, sat:*, eopf:*...
}
class Asset {
  href
  title, description
  type, roles
  file:size, file:checksum
  alternate
}
class Provider {
  name, description
  roles, url
}
class Link {
  href, rel, type, title
}

Catalog "1" o-- "*" Collection : child links
Collection "1" o-- "*" Item : items
Collection "1" *-- "*" Provider
Item "1" *-- "1" Properties
Item "1" *-- "*" Asset
Catalog *-- "*" Link
Collection *-- "*" Link
Item *-- "*" Link
@enduml
