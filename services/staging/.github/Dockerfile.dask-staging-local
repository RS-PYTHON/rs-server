# We will add rs-server-staging to the dask-gateway-server image for local mode
FROM ghcr.io/rs-python/dask-gateway-server/base/local:2024.1.0

# Default user from parent image
ARG USER=dask:dask

# Set labels based on the Open Containers Initiative (OCI):
# https://github.com/opencontainers/image-spec/blob/main/annotations.md#pre-defined-annotation-keys
#
LABEL org.opencontainers.image.source="https://github.com/RS-PYTHON/rs-server"
LABEL org.opencontainers.image.url="https://github.com/RS-PYTHON/rs-server/blob/develop/services/staging/.github/Dockerfile.dask-staging-local"

# Install dependencies for compilation
USER root
RUN apt update && apt upgrade -y && apt install -y libpq-dev gcc
USER $USER

# The CI builds the wheel packages, downloads them into ./whl/, then builds this Dockerfile from ./whl/,
# so the .whl files are under ./*.whl
# We copy them into a /tmp directory that we can clean at the end.
RUN mkdir -p /tmp/whl
ADD ./*.whl /tmp/whl

# Install the wheel packages in the right order (dependencies first).
# This also installs all the sub-dependencies e.g. fastapi etc ...
RUN cd /tmp/whl && pip install --no-cache-dir rs_server_staging-*.whl

# Install opentelemetry instrumentation packages for dependencies
RUN opentelemetry-bootstrap -a install

# Remove dependencies for compilation
USER root
RUN apt autoremove -y libpq-dev gcc

# Install dependencies necessary for execution (e.g. libpq) not compilation (gcc)
RUN apt install -y libpq-dev libexpat1

# Clean everything
RUN rm -rf /tmp/whl /root/.cache/pip /var/cache/apt/archives /var/lib/apt/lists/*
USER $USER
